NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:your-password@host:5432/database
# Railway provides DATABASE_URL automatically when a PostgreSQL service is linked.
# If using separate PostgreSQL variables instead, set PGHOST, PGPORT, PGDATABASE,
# PGUSER, and PGPASSWORD; the backend assembles DATABASE_URL automatically.
DATABASE_SSL=true
SUPABASE_URL=https://your-project.supabase.co
# Use the current Supabase secret key in production. The legacy service-role
# name remains supported for older deployments.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Optional least-privilege alternative for /auth/v1/user validation.
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
JWT_SECRET=novarix_jwt_secret_key_2024_secure
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
APP_URL=http://localhost:5173
BASE_URL=http://localhost:5173
# Comma-separated browser origins; set to the exact Vercel URL in production.
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
