VITE_API_ORIGIN=http://localhost:5000
VITE_SIGNALING_URL=http://localhost:5000
VITE_BACKEND_PORT=5000
VITE_PORT=5000

# ===== SUPABASE (OAuth Google / Apple + Magic Link Yahoo) =====
# Dapatkan dari: https://supabase.com/dashboard/project/_/settings/api
# - VITE_SUPABASE_URL      = Project URL
# - VITE_SUPABASE_ANON_KEY = anon public key (bukan service_role!)
# Contoh:
# VITE_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.....
VITE_SUPABASE_URL=https://jxymwfbabhxgzbpxbmce.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# OAuth is opt-in. Only list providers that are enabled in Supabase Auth.
# Example: VITE_ENABLED_OAUTH_PROVIDERS=google,yahoo,apple
VITE_ENABLED_OAUTH_PROVIDERS=
