VITE_API_URL=
# Deprecated alias for older local/Capacitor builds.
VITE_API_ORIGIN=
# Optional legacy separate Socket.IO endpoint; normally leave empty.
VITE_SIGNALING_URL=
VITE_BACKEND_PORT=5000
# JSON array of ICE servers. Use an ephemeral TURN credential service in
# production; public STUN alone cannot traverse every NAT/firewall.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Optional comma-separated allowlist. Google is enabled by default when
# Supabase is configured; add yahoo/apple only after configuring them in
# Supabase Auth and setting their provider credentials.
VITE_ENABLED_OAUTH_PROVIDERS=google
