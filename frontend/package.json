{
  "name": "novarix-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "cross-env VITE_API_ORIGIN=https://novarixapp-production.up.railway.app vite build",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@supabase/supabase-js": "^2.34.0",
    "axios": "^1.6.0",
    "lucide-react": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.0"
  }
}
